# Variáveis opcionais. Sem elas a página funciona inteira — sem medição e com
# o formulário oferecendo o WhatsApp no lugar do envio.
# Copie para `.env.local` no desenvolvimento; em produção, defina no build
# (GitHub → Settings → Secrets and variables → Actions → Variables).

# API do formulário (Function URL da Lambda — impressa pelo aws-leads.sh).
VITE_LEADS_URL=

# Google Tag Manager — a agência gerencia as tags por lá. Ex.: GTM-XXXXXXX
VITE_GTM_ID=

# Tag do Google direto, sem GTM (use um OU outro). Ex.: G-XXXX ou AW-XXXX
VITE_GTAG_ID=
# Conversões do Google Ads (send_to). Ex.: AW-123456789/AbCdEfGh
VITE_GADS_WHATSAPP=
VITE_GADS_LEAD=

# Pixel da Meta (ID numérico).
VITE_META_PIXEL_ID=

# Sentry. Sem DSN, o pacote sequer é baixado pelo navegador.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
